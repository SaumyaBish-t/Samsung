# ── LiveKit Cloud (free tier: https://cloud.livekit.io) ──────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Benchmark judge (used by FDB-v3 evaluation scripts, gpt-4o) ─
OPENAI_API_KEY=

# ── STT: Groq Whisper ─────────────────────────────────────────────
GROQ_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo

# ── Planner LLM: Ollama Cloud ────────────────────────────────────
OLLAMA_API_KEY=
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:120b
# LLM_FALLBACK_MODEL=gemma4:31b
# LLM_REASONING_EFFORT=low

# ── TTS: Kokoro (local Kokoro-FastAPI container) ─────────────────
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_VOICE=af_heart

# ── Turn taking / mock latency ───────────────────────────────────
# TURN_DETECTOR=english
# MIN_ENDPOINTING_DELAY=0.5
# MAX_ENDPOINTING_DELAY=3.0
# MOCK_LATENCY=instant
